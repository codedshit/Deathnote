-- // Minimization Logic
local minimized = false
TopBar.MouseButton1Click:Connect(function()
    minimized = not minimized
    ContentContainer.Visible = not minimized
    MainFrame.Size = minimized and UDim2.new(0, 300, 0, 35) or UDim2.new(0, 300, 0, 200)
end)

-- // Draggable Logic
local dragging, dragInput, dragStart, startPos
TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement and dragging then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

-- // ESP & Role Detection System
local espCache = {}

local function createESP(player)
    if player == LocalPlayer then return end
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "DN_ESP"
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Parent = CoreGui
    
    espCache[player] = highlight
end

local function removeESP(player)
    if espCache[player] then
        espCache[player]:Destroy()
        espCache[player] = nil
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    createESP(player)
end
Players.PlayerAdded:Connect(createESP)
Players.PlayerRemoving:Connect(removeESP)

-- // Notification System
local function sendNotification(msg)
    local notif = Instance.new("TextLabel")
    notif.Size = UDim2.new(0, 250, 0, 35)
    notif.Position = UDim2.new(1, -260, 1, -50)
    notif.BackgroundColor3 = Color3.fromRGB(15, 15, 15)
    notif.TextColor3 = Color3.fromRGB(255, 60, 60)
    notif.Font = Enum.Font.Code
    notif.TextSize = 12
    notif.Text = msg
    notif.Parent = ScreenGui
    
    task.delay(3, function()
        notif:Destroy()
    end)
end

-- // Main Loop for Role Checking & ESP Updating
RunService.RenderStepped:Connect(function()
    local detectedKira = "None"
    
    for player, highlight in pairs(espCache) do
        local character = player.Character
        if character and character:FindFirstChild("HumanoidRootPart") then
            highlight.Adornee = character
            
            -- Check for Death Note or Kira indicators in backpack/character
            local isKira = false
            local backpack = player:FindFirstChild("Backpack")
            
            if character:FindFirstChild("Death Note") or (backpack and backpack:FindFirstChild("Death Note")) then
                isKira = true
                detectedKira = player.Name
            end
            
            if isKira then
                highlight.FillColor = Color3.fromRGB(255, 50, 50)
                highlight.OutlineColor = Color3.fromRGB(255, 0, 0)
            else
                highlight.FillColor = Color3.fromRGB(120, 120, 120)
                highlight.OutlineColor = Color3.fromRGB(80, 80, 80)
            end
        else
            highlight.Adornee = nil
        end
    end
    
    StatusLabel.Text = string.format("Status: Active\nCurrent Kira: %s", detectedKira)
end)

-- // Monitor Tool pickups / ID drops in workspace
workspace.ChildAdded:Connect(function(child)
    if child.Name:lower():find("id") or child.Name:lower():find("note") then
        sendNotification("[!] Item spawned/picked up: " .. child.Name)
    end
end)

