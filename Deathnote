-- ==================== ESP SYSTEMS ====================

local function ClearESP()
    for _, highlight in pairs(ESPHighlights) do
        if highlight and highlight.Destroy then highlight:Destroy() end
    end
    ESPHighlights = {}
    
    for _, highlight in pairs(PlayerESPHighlights) do
        if highlight and highlight.Destroy then highlight:Destroy() end
    end
    PlayerESPHighlights = {}
    
    for _, highlight in pairs(KiraESPHighlights) do
        if highlight and highlight.Destroy then highlight:Destroy() end
    end
    KiraESPHighlights = {}
    
    for _, highlight in pairs(ObjectESPHighlights) do
        if highlight and highlight.Destroy then highlight:Destroy() end
    end
    ObjectESPHighlights = {}
end

local function HighlightCharacter(character, color, outlineColor)
    if not character then return end
    for _, child in pairs(character:GetChildren()) do
        if child:IsA("Highlight") then child:Destroy() end
    end
    
    local hrp = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 3)
    if hrp then
        local highlight = Instance.new("Highlight")
        highlight.FillColor = color
        highlight.OutlineColor = outlineColor or color
        highlight.FillTransparency = 0.5
        highlight.OutlineTransparency = 0
        highlight.Parent = character
        table.insert(ESPHighlights, highlight)
        return highlight
    end
end

local function UpdatePlayerESP()
    if not Config.PlayerESPEnabled then return end
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            if not table.find(PlayerESPHighlights, player) then
                local hl = HighlightCharacter(player.Character, Color3.fromRGB(100, 150, 255))
                if hl then table.insert(PlayerESPHighlights, hl) end
            end
        end
    end
end

local function UpdateKiraESP()
    if not Config.KiraESPEnabled then return end
    for _, player in pairs(KiraList) do
        if player.Character then
            local exists = false
            for _, hl in pairs(KiraESPHighlights) do
                if hl.Parent == player.Character then exists = true break end
            end
            if not exists then
                local hl = HighlightCharacter(player.Character, Color3.fromRGB(255, 50, 50), Color3.fromRGB(150, 0, 0))
                if hl then table.insert(KiraESPHighlights, hl) end
            end
        end
    end
end

local function UpdateObjectESP()
    if not (Config.DeathNoteESP or Config.IDsESP or Config.YourIDESP) then return end
    
    local map = workspace:FindFirstChild("Map")
    if not map then return end
    
    -- Death Note ESP
    if Config.DeathNoteESP then
        for _, obj in pairs(workspace:GetDescendants()) do
            if obj.Name == "DeathNoteBook" and obj:IsA("Model") then
                local exists = false
                for _, hl in pairs(ObjectESPHighlights) do
                    if hl.Parent == obj then exists = true break end
                end
                if not exists then
                    local hl = Instance.new("Highlight")
                    hl.FillColor = Color3.fromRGB(150, 0, 200)
                    hl.OutlineColor = Color3.fromRGB(100, 0, 150)
                    hl.Parent = obj
                    table.insert(ObjectESPHighlights, hl)
                end
            end
        end
    end
    
    -- ID ESP
    if Config.IDsESP or Config.YourIDESP then
        for _, obj in pairs(map:GetChildren()) do
            if obj.Name == "Id" then
                local isMyID = false
                local isClaimed = false
                
                if Config.YourIDESP then
                    local surfaceGui = obj:FindFirstChild("SurfaceGui")
                    if surfaceGui then
                        local frame = surfaceGui:FindFirstChild("Frame")
                        if frame then
                            local nameLabel = frame:FindFirstChild("PlayerName")
                            if nameLabel and (nameLabel.Text == LocalPlayer.Name or nameLabel.Text == LocalPlayer.DisplayName) then
                                isMyID = true
                            end
                        end
                    end
                end
                
                if Config.IDsESP and not isMyID then
                    isClaimed = true -- Simplified check
                end
                
                if (Config.YourIDESP and isMyID) or (Config.IDsESP and not isMyID) then
                    local exists = false
                    for _, hl in pairs(ObjectESPHighlights) do
                        if hl.Parent == obj then 
                            exists = true
                            -- Update color
                            if isMyID then
                                hl.FillColor = Color3.fromRGB(0, 255, 100)
                                hl.OutlineColor = Color3.fromRGB(0, 150, 50)
                            elseif isClaimed then
                                hl.FillColor = Color3.fromRGB(100, 100, 100)
                            else
                                hl.FillColor = Color3.fromRGB(255, 255, 0)
                            end
                            break 
                        end
                    end
                    if not exists then
                        local hl = Instance.new("Highlight")
                        if isMyID then
                            hl.FillColor = Color3.fromRGB(0, 255, 100)
                            hl.OutlineColor = Color3.fromRGB(0, 150, 50)
                        elseif isClaimed then
                            hl.FillColor = Color3.fromRGB(100, 100, 100)
                            hl.OutlineColor = Color3.fromRGB(50, 50, 50)
                        else
                            hl.FillColor = Color3.fromRGB(255, 255, 0)
                            hl.OutlineColor = Color3.fromRGB(150, 150, 0)
                        end
                        hl.Parent = obj
                        table.insert(ObjectESPHighlights, hl)
                    end
                end
            end
        end
    end
end

-- ==================== DETECTION SYSTEM ====================

local function FetchCurrentId(map, player)
    if not map then return nil end
    for _, v in pairs(map:GetChildren()) do
        if v.Name == "Id" then
            local surfaceGui = v:FindFirstChild("SurfaceGui")
            if surfaceGui then
                local frame = surfaceGui:FindFirstChild("Frame")
                if frame then
                    local nameLabel = frame:FindFirstChild("PlayerName")
                    if nameLabel and (nameLabel.Text == player.Name or nameLabel.Text == player.DisplayName) then
                        return v
                    end
                end
            end
        end
    end
    return nil
end

local function ClosestPlayerToPosition(position)
    local closest = nil
    local minDist = math.huge
    for _, player in pairs(Players:GetPlayers()) do
        if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (player.Character.HumanoidRootPart.Position - position).Magnitude
            if dist < minDist then
                minDist = dist
                closest = player
            end
        end
    end
    return closest, minDist
end

local function ClearAllDetection()
    DetectionActive = false
    KiraList = {}
    TakaList = {}
    LList = {}
    for _, con in pairs(Connections) do
        if con and con.Disconnect then con:Disconnect() end
    end
    Connections = {}
    ClearESP()
end

local function CheckForIDPickups(map)
    if not map then return end
    
    for _, id in pairs(map:GetChildren()) do
        if id.Name == "Id" then
            local surfaceGui = id:FindFirstChild("SurfaceGui")
            if surfaceGui then
                local conn = surfaceGui:GetPropertyChangedSignal("Enabled"):Connect(function()
                    if not surfaceGui.Enabled then
                        -- ID was picked up
                        local idOwner = nil
                        local frame = surfaceGui:FindFirstChild("Frame")
                        if frame then
                            local nameLabel = frame:FindFirstChild("PlayerName")
                            if nameLabel then
                                for _, plr in pairs(Players:GetPlayers()) do
                                    if plr.Name == nameLabel.Text or plr.DisplayName == nameLabel.Text then
                                        idOwner = plr
                                        break
                                    end
                                end
                            end
                        end
                
                        local picker, dist = ClosestPlayerToPosition(id.Position)
                        if picker and idOwner and dist < 15 then
                            if not table.find(TakaList, picker) then
                                table.insert(TakaList, picker)
                            end
                            
                            local pickerName = picker.DisplayName ~= picker.Name 
                                and picker.DisplayName .. " (" .. picker.Name .. ")" 
                                or picker.Name
                            local ownerName = idOwner.DisplayName ~= idOwner.Name 
                                and idOwner.DisplayName .. " (" .. idOwner.Name .. ")" 
                                or idOwner.Name
                                
                            ShowIDPickupNotification(pickerName, ownerName)
                        end
                    end
                end)
                table.insert(Connections, conn)
            end
        end
    end
end

local function CheckForDeathNotes()
    for _, player in pairs(Players:GetPlayers()) do
        if player.Character then
            local conn = player.Character.ChildAdded:Connect(function(child)
                if child.Name == "DeathNoteBook" then
                    if not table.find(KiraList, player) then
                        table.insert(KiraList, player)
                        Notify("Kira Detected", player.DisplayName .. " has the Death Note!", 4)
                    end
                end
            end)
            table.insert(Connections, conn)
            
            -- Check existing
            if player.Character:FindFirstChild("DeathNoteBook") then
                if not table.find(KiraList, player) then
                    table.insert(KiraList, player)
                end
            end
        end
    end
end

local function TryFetchL()
    local highestChance = 0
    local candidates = {}
    
    for _, player in pairs(Players:GetPlayers()) do
        if not table.find(KiraList, player) and not table.find(TakaList, player) then
            local chance = nil
            
            -- Try different possible locations
            if player:FindFirstChild("LChance_Weight") then
                chance = player.LChance_Weight.Value
            elseif player:FindFirstChild("LChance") then
                chance = player.LChance.Value
            end
            
            if chance then
                if chance > highestChance then
                    highestChance = chance
                    candidates = {player}
                elseif chance == highestChance then
                    table.insert(candidates, player)
                end
            end
        end
    end
    
    LList = candidates
    return candidates, highestChance
end

local function AutoClearCheck()
    if GamePhase then
        GamePhase:GetPropertyChangedSignal("Value"):Connect(function()
            local newPhase = GamePhase.Value
            if newPhase == "Starting" or newPhase == "Intermission" then
                ClearAllDetection()
                Notify("Match Reset", "Detection data cleared for new match", 3)
            end
        end)
    end
    
    -- Also check on character spawn
    LocalPlayer.CharacterAdded:Connect(function()
        task.wait(2)
        if GamePhase and (GamePhase.Value == "Starting" or GamePhase.Value == "Intermission") then
            ClearAllDetection()
        end
    end)
end

-- ==================== TELEPORT & UTILITIES ====================

local function TeleportToYourID()
    local map = workspace:FindFirstChild("Map")
    if not map then
        Notify("Error", "Map not found", 3)
        return
    end
    
    local myID = FetchCurrentId(map, LocalPlayer)
    if myID and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.Character.HumanoidRootPart.CFrame = myID.CFrame * CFrame.new(0, 3, 0)
        Notify("Teleported", "Moved to your ID", 2)
    else
        -- Find unclaimed ID
        for _, id in pairs(map:GetChildren()) do
            if id.Name == "Id" then
                local claimed = false
                for _, plr in pairs(Players:GetPlayers()) do
                    if FetchCurrentId(map, plr) == id then
                        claimed = true
                        break
                    end
                end
                if not claimed then
                    LocalPlayer.Character.HumanoidRootPart.CFrame = id.CFrame * CDim2.new(0, 3, 0)
                    Notify("Teleported", "Moved to unclaimed ID", 2)
                    return
                end
            end
        end
        Notify("Error", "No available IDs", 3)
    end
end

local function TeleportToPlayer(playerName)
    local target = nil
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Name:lower() == playerName:lower() or plr.DisplayName:lower() == playerName:lower() then
            target = plr
            break
        end
    end
    
    if not target then
        -- Partial match
        for _, plr in pairs(Players:GetPlayers()) do
            if plr.Name:lower():find(playerName:lower()) or plr.DisplayName:lower():find(playerName:lower()) then
                target = plr
                break
            end
        end
    end
    
    if target and target.Character and target.Character:FindFirstChild("HumanoidRootPart") then
        if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            LocalPlayer.Character.HumanoidRootPart.CFrame = target.Character.HumanoidRootPart.CFrame * CFrame.new(0, 0, 3)
            Notify("Teleported", "Moved to " .. target.DisplayName, 2)
        end
    else
        Notify("Error", "Player not found", 3)
    end
end

local function ToggleNoclip(enabled)
    if enabled then
        NoclipConnection = RunService.Stepped:Connect(function()
            if LocalPlayer.Character then
                for _, part in pairs(LocalPlayer.Character:GetDescendants()) do
                    if part:IsA("BasePart") then
                        part.CanCollide = false
                    end
                end
            end
        end)
    else
        if NoclipConnection then
            NoclipConnection:Disconnect()
            NoclipConnection = nil
        end
    end
end

local function AutoSearchDN()
    if GamePhase and GamePhase.Value ~= "Search" then
        Notify("Error", "Not in search phase", 3)
        return
    end
    
    local map = workspace:FindFirstChild("Map")
    if not map then return end
    
    Notify("Auto Search", "Searching for Death Note...", 3)
    
    for _, crate in pairs(map:GetChildren()) do
        if crate.Name == "Crate" then
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                LocalPlayer.Character.HumanoidRootPart.CFrame = crate.CFrame * CFrame.new(0, 2, 0)
                task.wait(0.3)
                if GamePhase.Value ~= "Search" then break end
            end
        end
    end
end

local function GetMisaCodes()
    if not Gamemode or Gamemode.Value ~= "MisaGame" then
        Notify("Error", "Not in Misa game mode", 3)
        return
    end
    
    local codes = {}
    if GameFolder and GameFolder:FindFirstChild("FolderForNames") then
        for _, nameObj in pairs(GameFolder.FolderForNames:GetChildren()) do
            if nameObj.Value then
                codes[tostring(nameObj.Value)] = nameObj.Name
            end
        end
    end
    
    if next(codes) then
        local msg = "Misa Codes:\n"
        for player, code in pairs(codes) do
            msg = msg .. player .. ": " .. code .. "\n"
        end
        Notify("Misa Codes", msg, 10)
    else
        Notify("Misa Codes", "No codes found yet", 3)
    end
end

local function FiddlePrompts()
    local map = workspace:FindFirstChild("Map")
    if not map then return end
    
    for _, obj in pairs(map:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            obj.HoldDuration = 0
            obj.MaxActivationDistance = 1000
            obj.RequiresLineOfSight = false
        end
    end
    Notify("Prompts Modified", "Instant pickup enabled", 2)
end

