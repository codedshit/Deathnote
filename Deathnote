-- ==================== UTILITY FUNCTIONS ====================

local function SaveConfig()
    local success, err = pcall(function()
        if not isfolder(ConfigFolder) then
            makefolder(ConfigFolder)
        end
        writefile(ConfigFile, HttpService:JSONEncode(Config))
    end)
    if not success then
        warn("Fare well: Failed to save config - " .. tostring(err))
    end
end

local function LoadConfig()
    local success, result = pcall(function()
        if isfile(ConfigFile) then
            local data = readfile(ConfigFile)
            return HttpService:JSONDecode(data)
        end
        return nil
    end)
    
    if success and result then
        for key, value in pairs(result) do
            if Config[key] ~= nil then
                Config[key] = value
            end
        end
    end
end

local function Notify(title, message, duration)
    if not Config.NotificationEnabled then return end
    duration = duration or 3
    
    -- Create notification GUI
    local notifGui = Instance.new("ScreenGui")
    notifGui.Name = "FareWell_Notification"
    notifGui.Parent = PlayerGui
    
    local frame = Instance.new("Frame")
    frame.Size = UDim2.new(0, 300, 0, 60)
    frame.Position = UDim2.new(0.5, -150, 0, -70)
    frame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
    frame.BorderSizePixel = 0
    frame.Parent = notifGui
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = frame
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(100, 50, 150)
    stroke.Thickness = 2
    stroke.Parent = frame
    
    local titleLabel = Instance.new("TextLabel")
    titleLabel.Size = UDim2.new(1, -20, 0, 25)
    titleLabel.Position = UDim2.new(0, 10, 0, 5)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Text = title
    titleLabel.TextColor3 = Color3.fromRGB(200, 150, 255)
    titleLabel.TextSize = 16
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextXAlignment = Enum.TextXAlignment.Left
    titleLabel.Parent = frame
    
    local msgLabel = Instance.new("TextLabel")
    msgLabel.Size = UDim2.new(1, -20, 0, 25)
    msgLabel.Position = UDim2.new(0, 10, 0, 30)
    msgLabel.BackgroundTransparency = 1
    msgLabel.Text = message
    msgLabel.TextColor3 = Color3.fromRGB(220, 220, 220)
    msgLabel.TextSize = 14
    msgLabel.Font = Enum.Font.Gotham
    msgLabel.TextXAlignment = Enum.TextXAlignment.Left
    msgLabel.TextWrapped = true
    msgLabel.Parent = frame
    
    -- Animate in
    TweenService:Create(frame, TweenInfo.new(0.5, Enum.EasingStyle.Quart), {
        Position = UDim2.new(0.5, -150, 0, 20)
    }):Play()
    
    -- Remove after duration
    task.delay(duration, function()
        local outTween = TweenService:Create(frame, TweenInfo.new(0.5, Enum.EasingStyle.Quart), {
            Position = UDim2.new(0.5, -150, 0, -70)
        })
        outTween:Play()
        outTween.Completed:Wait()
        notifGui:Destroy()
    end)
end

