    MiscTab:CreateToggle({
        Name = "Noclip",
        CurrentValue = Config.Noclip,
        Flag = "Noclip",
        Callback = function(Value)
            Config.Noclip = Value
            ToggleNoclip(Value)
            SaveConfig()
        end
    })
    
    MiscTab:CreateButton({
        Name = "Auto Search DN",
        Callback = AutoSearchDN
    })
    
    MiscTab:CreateButton({
        Name = "Instant Prompts",
        Callback = function()
            local map = workspace:FindFirstChild("Map")
            if map then
                for _, obj in pairs(map:GetDescendants()) do
                    if obj:IsA("ProximityPrompt") then
                        obj.HoldDuration = 0
                        obj.MaxActivationDistance = 1000
                        obj.RequiresLineOfSight = false
                    end
                end
                Notify("Prompts Modified", "Instant pickup enabled", 2)
            end
        end
    })
    
    -- Settings Tab
    local SettingsTab = Window:CreateTab("Settings")
    
    SettingsTab:CreateSection("Configuration")
    
    SettingsTab:CreateToggle({
        Name = "Notifications",
        CurrentValue = Config.Notifications,
        Flag = "Notifications",
        Callback = function(Value)
            Config.Notifications = Value
            SaveConfig()
        end
    })
    
    SettingsTab:CreateKeybind({
        Name = "UI Toggle Keybind",
        CurrentKeybind = Config.Keybind,
        HoldToInteract = false,
        Flag = "Keybind",
        Callback = function(Keybind)
            Config.Keybind = Keybind
            SaveConfig()
        end
    })
    
    SettingsTab:CreateButton({
        Name = "Reset Configuration",
        Callback = function()
            Config = {
                PlayerESP = false,
                KiraESP = false,
                DeathNoteESP = false,
                IDsESP = false,
                YourIDESP = false,
                Noclip = false,
                AutoSearch = false,
                Notifications = true,
                AutoFish = false,
                AutoShinigamis = false,
                AutoTitles = false,
                Keybind = Enum.KeyCode.K
            }
            SaveConfig()
            Notify("Config Reset", "Please re-execute script", 3)
        end
    })
    
    -- ESP Loop
    RunService.RenderStepped:Connect(UpdateESP)
    
    -- Auto-clear on new match
    if GamePhase then
        GamePhase:GetPropertyChangedSignal("Value"):Connect(function()
            local newPhase = GamePhase.Value
            if newPhase == "Starting" or newPhase == "Intermission" then
                ClearDetection()
                Notify("Match Reset", "Detection data cleared", 3)
            end
        end)
    end
    
    -- Anti-AFK
    LocalPlayer.Idled:Connect(function()
        VirtualUser:Button2Down(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
        task.wait(1)
        VirtualUser:Button2Up(Vector2.new(0, 0), workspace.CurrentCamera.CFrame)
    end)
    
    Notify("Fare well", "Script loaded successfully!", 4)
end

-- Start
Initialize()
