        ColorSequenceKeypoint.new(0, Color3.fromRGB(40, 30, 60)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(25, 25, 30))
    })
    gradient.Parent = container
    
    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, -20, 1, -10)
    textLabel.Position = UDim2.new(0, 10, 0, 5)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = pickerName .. " <font color=\"rgb(200,150,255)\">picked up</font> " .. idOwnerName .. "'s <font color=\"rgb(255,100,100)\">ID</font>"
    textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    textLabel.TextSize = 18
    textLabel.Font = Enum.Font.GothamBold
    textLabel.RichText = true
    textLabel.Parent = container
    
    -- Animate in from top
    TweenService:Create(container, TweenInfo.new(0.6, Enum.EasingStyle.Back), {
        Position = UDim2.new(0.5, -200, 0, 80)
    }):Play()
    
    -- Pulse effect
    task.spawn(function()
        for i = 1, 3 do
            stroke.Color = Color3.fromRGB(200, 150, 255)
            task.wait(0.2)
            stroke.Color = Color3.fromRGB(147, 112, 219)
            task.wait(0.2)
        end
    end)
    
    -- Remove after 4 seconds
    task.delay(4, function()
        local outTween = TweenService:Create(container, TweenInfo.new(0.5, Enum.EasingStyle.Quart), {
            Position = UDim2.new(0.5, -200, 0, -60)
        })
        outTween:Play()
        outTween.Completed:Wait()
        notifGui:Destroy()
    end)
end

