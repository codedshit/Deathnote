-- ==================== ESP SYSTEM ====================

local function ClearESP()
    for _, hl in pairs(ESPHighlights) do
        if hl and hl.Parent then hl:Destroy() end
    end
    ESPHighlights = {}
end

local function CreateHighlight(obj, color, outline)
    if not obj then return end
    local hl = Instance.new("Highlight")
    hl.FillColor = color
    hl.OutlineColor = outline or color
    hl.FillTransparency = 0.5
    hl.OutlineTransparency = 0
    hl.Parent = obj
    table.insert(ESPHighlights, hl)
    return hl
end

local function UpdateESP()
    ClearESP()
    
    if Config.PlayerESP then
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                CreateHighlight(plr.Character, Color3.fromRGB(100, 150, 255))
            end
        end
    end
    
    if Config.KiraESP then
        for _, kira in pairs(KiraList) do
            if kira.Character then
                CreateHighlight(kira.Character, Color3.fromRGB(255, 50, 50), Color3.fromRGB(150, 0, 0))
            end
        end
    end
    
    -- Object ESP
    if Config.DeathNoteESP or Config.IDsESP or Config.YourIDESP then
        local map = workspace:FindFirstChild("Map")
        if map then
            for _, obj in pairs(map:GetDescendants()) do
                if obj:IsA("Model") or obj:IsA("Part") then
                    if Config.DeathNoteESP and obj.Name:find("DeathNote") then
                        CreateHighlight(obj, Color3.fromRGB(150, 0, 200))
                    elseif Config.IDsESP and obj.Name == "Id" then
                        local isMine = false
                        if Config.YourIDESP then
                            local sg = obj:FindFirstChild("SurfaceGui")
                            if sg then
                                local frame = sg:FindFirstChild("Frame")
                                if frame then
                                    local nameLabel = frame:FindFirstChild("PlayerName")
                                    if nameLabel and (nameLabel.Text == LocalPlayer.Name or nameLabel.Text == LocalPlayer.DisplayName) then
                                        isMine = true
                                    end
                                end
                            end
                        end
                        if isMine then
                            CreateHighlight(obj, Color3.fromRGB(0, 255, 100))
                        else
                            CreateHighlight(obj, Color3.fromRGB(255, 255, 0))
                        end
                    end
                end
            end
        end
    end
end

-- ==================== DETECTION SYSTEM ====================

local function ClosestPlayerToPosition(pos)
    local closest, minDist = nil, math.huge
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (plr.Character.HumanoidRootPart.Position - pos).Magnitude
            if dist < minDist then
                minDist = dist
                closest = plr
            end
        end
    end
    return closest, minDist
end

local function ClearDetection()
    DetectionActive = false
    KiraList = {}
    TakaList = {}
    LList = {}
    for _, con in pairs(Connections) do
        if con then pcall(function() con:Disconnect() end) end
    end
    Connections = {}
end

local function CheckIDPickups(map)
    for _, id in pairs(map:GetChildren()) do
        if id.Name == "Id" then
            local sg = id:FindFirstChild("SurfaceGui")
            if sg then
                local con = sg:GetPropertyChangedSignal("Enabled"):Connect(function()
                    if not sg.Enabled then
                        -- ID picked up
                        local owner = nil
                        local frame = sg:FindFirstChild("Frame")
                        if frame then
                            local nl = frame:FindFirstChild("PlayerName")
                            if nl then
                                for _, plr in pairs(Players:GetPlayers()) do
                                    if plr.Name == nl.Text or plr.DisplayName == nl.Text then
                                        owner = plr
                                        break
                                    end
                                end
                            end
                        end
                        
                        local picker, dist = ClosestPlayerToPosition(id.Position)
                        if picker and owner and dist < 15 then
                            if not table.find(TakaList, picker) then
                                table.insert(TakaList, picker)
                            end
                            
                            local pn = picker.DisplayName ~= picker.Name and picker.DisplayName .. " (" .. picker.Name .. ")" or picker.Name
                            local on = owner.DisplayName ~= owner.Name and owner.DisplayName .. " (" .. owner.Name .. ")" or owner.Name
                            ShowIDPickupNotification(pn, on)
                        end
                    end
                end)
                table.insert(Connections, con)
            end
        end
    end
end

local function CheckKira()
    for _, plr in pairs(Players:GetPlayers()) do
        if plr.Character then
            local con = plr.Character.ChildAdded:Connect(function(child)
                if child.Name == "DeathNoteBook" then
                    if not table.find(KiraList, plr) then
                        table.insert(KiraList, plr)
                        Notify("Kira Detected", plr.DisplayName .. " has the Death Note!", 4)
                    end
                end
            end)
            table.insert(Connections, con)
            
            if plr.Character:FindFirstChild("DeathNoteBook") then
                if not table.find(KiraList, plr) then
                    table.insert(KiraList, plr)
                end
            end
        end
    end
end

local function TryFetchL()
    local highest = 0
    local candidates = {}
    
    for _, plr in pairs(Players:GetPlayers()) do
        if not table.find(KiraList, plr) and not table.find(TakaList, plr) then
            local chance = nil
            if plr:FindFirstChild("LChance_Weight") then
                chance = plr.LChance_Weight.Value
            elseif plr:FindFirstChild("LChance") then
                chance = plr.LChance.Value
            end
            
            if chance then
                if chance > highest then
                    highest = chance
                    candidates = {plr}
                elseif chance == highest then
                    table.insert(candidates, plr)
                end
            end
        end
    end
    
    LList = candidates
    return candidates, highest
end

-- ==================== FISHING SYSTEM ====================

local function StartFishing()
    local SpinSystem = ReplicatedStorage:WaitForChild("Game"):WaitForChild("Remotes"):WaitForChild("SpinSystem")
    local MinigameEvent = ReplicatedStorage:WaitForChild("Game"):WaitForChild("Remotes"):WaitForChild("MinigameEvent")
    
    -- Auto Fish
    if Config.AutoFish then
        local fishCon = task.spawn(function()
            while Config.AutoFish do
                pcall(function()
                    MinigameEvent:FireServer({Status = "CaughtFish"})
                end)
                task.wait(0.2)
            end
        end)
        table.insert(FishingConnections, fishCon)
    end
    
    -- Auto Shinigamis
    if Config.AutoShinigamis then
        local shiniCon = task.spawn(function()
            while Config.AutoShinigamis do
                pcall(function()
                    SpinSystem:FireServer({Category = "Shinigamis"})
                end)
                task.wait(0.2)
            end
        end)
        table.insert(FishingConnections, shiniCon)
    end
    
    -- Auto Titles
    if Config.AutoTitles then
        local titleCon = task.spawn(function()
            while Config.AutoTitles do
                pcall(function()
                    SpinSystem:FireServer({Category = "Titles"})
                end)
                task.wait(0.2)
            end
        end)
        table.insert(FishingConnections, titleCon)
    end
end

local function StopFishing()
    for _, con in pairs(FishingConnections) do
        if type(con) == "thread" then
            pcall(function() task.cancel(con) end)
        end
    end
    FishingConnections = {}
end

